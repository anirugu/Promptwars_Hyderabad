# This file controls which local files are skipped when running
# `gcloud app deploy` / `gcloud run deploy --source`.
# Anything matched here is NOT uploaded to Google Cloud.

# --- Node ---
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# --- Build artifacts (Docker rebuilds these fresh in-container) ---
dist

# --- Editor / OS ---
.git
.gitignore
.gitattributes
.idea
.vscode
.DS_Store
Thumbs.db

# --- Firebase local cache ---
.firebase

# --- Tooling / docs not needed in build context ---
.claude
.junie
memory
README.md
DEPLOY.md
*.log
*.tmp

# Note: .env.local is intentionally NOT excluded — Vite reads it during the
# in-container build to inline the VITE_FIREBASE_* config into the bundle.
