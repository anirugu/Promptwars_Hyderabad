# Firebase web config — copy this file to `.env.local` and fill in real values.
# Get them from: Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# These values are safe to expose to the browser; security is enforced by Firestore rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
